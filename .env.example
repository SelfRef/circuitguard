# --- Discord ---
DISCORD_TOKEN=your-bot-token
# Optional: guild ID to sync commands to for instant updates (omit for global sync, ~1h propagation)
DISCORD_GUILD_ID=123456789012345678
# Comma-separated Discord role IDs with full access to every server
ADMIN_ROLE_IDS=111111111111111111,222222222222222222
# Comma-separated Discord role IDs granted mod access to auto-detected servers
# (only used when MC_SERVERS is omitted; manual entries carry their own mod_role_ids)
#MOD_ROLE_IDS=333333333333333333

# --- Crafty Controller ---
CRAFTY_URL=https://crafty.example.com
CRAFTY_API_TOKEN=your-crafty-api-token
CRAFTY_VERIFY_SSL=true

# --- Console backend ---
# rcon   (default): commands go to each server's RCON port (rcon_* required below)
# crafty:           commands go through the Crafty API only — no RCON ports needed,
#                   responses are scraped from the console log (best effort)
CONSOLE_BACKEND=rcon

# --- Managed servers ---
# Omit MC_SERVERS entirely to auto-detect all servers from Crafty (requires
# CONSOLE_BACKEND=crafty); the list is re-fetched before a command runs if it
# is older than 10 minutes.
#
# Or define them manually (JSON array; one object per Minecraft server):
# label:        shown in Discord autocomplete (must be unique)
# crafty_id:    Crafty v2 server UUID (from the Crafty UI or GET /api/v2/servers)
# rcon_*:       RCON as enabled in that server's server.properties
#               (omit when CONSOLE_BACKEND=crafty)
# mod_role_ids: Discord role IDs allowed to manage THIS server
MC_SERVERS='[{"label":"Survival","crafty_id":"a1b2c3d4-0000-0000-0000-000000000000","rcon_host":"mc-survival","rcon_port":25575,"rcon_password":"secret1","mod_role_ids":[333333333333333333]},{"label":"Creative","crafty_id":"e5f6a7b8-0000-0000-0000-000000000000","rcon_host":"mc-creative","rcon_port":25576,"rcon_password":"secret2","mod_role_ids":[]}]'

# --- Storage / misc ---
DB_PATH=/data/circuitguard.db
LOG_LEVEL=INFO
