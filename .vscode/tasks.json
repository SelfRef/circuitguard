{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run bot",
      "type": "shell",
      "command": "uv run python -m circuitguard",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "uv run pytest",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Lint + typecheck",
      "type": "shell",
      "command": "uv run ruff check . && uv run ruff format --check . && uv run mypy",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Release: replace release branch with master",
      "type": "process",
      "command": "git",
      "args": [
        "push",
        "--force",
        "origin",
        "master:release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
